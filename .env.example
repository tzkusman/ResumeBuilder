# ResumeBuild environment variables
# Copy to .env for local dev; in Vercel add these under
# Project → Settings → Environment Variables (all environments), then redeploy.
# Every value is OPTIONAL — the app runs in local/demo mode without them.

# Supabase (schema lives in /supabase/schema.sql — run it in the SQL Editor first)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
